{
	"name": "env",
	"description": "A cross platform env library for lde",
	"authors": ["David Cruz <david@bycruz.dev"],
	"version": "0.1.2",
	"dependencies": {
		"path": { "version": "0.1.0" }
	},
	"features": {
		"windows": ["env.raw.windows"],
		"linux": ["env.raw.posix", "env.raw.linux"],
